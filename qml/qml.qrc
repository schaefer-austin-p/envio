<RCC>
    <qresource prefix="/qml">
        <file>Main.qml</file>
        <file>pages/InboxPage.qml</file>
        <file>platform/qmldir</file>
        <file>platform/Theme.qml</file>
        <file>platform/ut/SystemColours.qml</file>
        <file>platform/ut/GridUnit.qml</file>
        <file>components/qmldir</file>
        <file>components/Avatar.qml</file>
        <file>components/Banner.qml</file>
        <file>components/AppButton.qml</file>
        <file>components/Chip.qml</file>
        <file>components/AppDialog.qml</file>
        <file>components/Field.qml</file>
        <file>components/Icon.qml</file>
        <file>components/IconButton.qml</file>
        <file>components/ListRow.qml</file>
        <file>components/RadioRow.qml</file>
        <file>components/Sheet.qml</file>
        <file>components/Toast.qml</file>
        <file>components/Toggle.qml</file>
        <file>components/TopBar.qml</file>
    </qresource>
    <!-- Theme.qml loads these as ../../third_party/fonts/..., on disk and here. -->
    <qresource prefix="/third_party">
        <file alias="fonts/Inter/Inter-Regular.ttf">../third_party/fonts/Inter/Inter-Regular.ttf</file>
        <file alias="fonts/Inter/Inter-Medium.ttf">../third_party/fonts/Inter/Inter-Medium.ttf</file>
        <file alias="fonts/Inter/Inter-SemiBold.ttf">../third_party/fonts/Inter/Inter-SemiBold.ttf</file>
        <file alias="fonts/IBMPlexMono/IBMPlexMono-Regular.ttf">../third_party/fonts/IBMPlexMono/IBMPlexMono-Regular.ttf</file>
        <file alias="fonts/IBMPlexMono/IBMPlexMono-Medium.ttf">../third_party/fonts/IBMPlexMono/IBMPlexMono-Medium.ttf</file>
        <file alias="fonts/IBMPlexMono/IBMPlexMono-SemiBold.ttf">../third_party/fonts/IBMPlexMono/IBMPlexMono-SemiBold.ttf</file>
        <file alias="fonts/Lora/Lora-Regular.ttf">../third_party/fonts/Lora/Lora-Regular.ttf</file>
        <file alias="fonts/Inter/OFL.txt">../third_party/fonts/Inter/OFL.txt</file>
        <file alias="fonts/IBMPlexMono/OFL.txt">../third_party/fonts/IBMPlexMono/OFL.txt</file>
        <file alias="fonts/Lora/OFL.txt">../third_party/fonts/Lora/OFL.txt</file>
        <file alias="fonts/Lora/Lora-SemiBold.ttf">../third_party/fonts/Lora/Lora-SemiBold.ttf</file>
    </qresource>
</RCC>
